index=<your_index>
( (sourcetype="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1)
  OR (sourcetype="WinEventLog:Security" EventCode=4688)
  OR (sourcetype IN ("WinEventLog:Microsoft-Windows-PowerShell/Operational","WinEventLog:PowerShellCore/Operational") EventCode=4104) )
( rclone OR OriginalFileName="rclone.exe" OR aws OR write-s3object OR gsutil OR gcloud OR azcopy OR set-azstorageblobcontent
  OR curl OR wget OR iwr OR irm OR invoke-webrequest OR invoke-restmethod
  OR uploadfile* OR uploaddata* OR uploadstring* OR postasync OR putasync
  OR bitsadmin OR start-bitstransfer OR scp OR pscp OR psftp OR python
  OR api.telegram.org OR discord.com OR discordapp.com OR mega.nz OR transfer.sh OR gofile.io OR file.io OR 0x0.st OR temp.sh )

| eval messagecut=replace(Message, "[\r\n]+", " ")
| rex field=messagecut "(?i)Creating Scriptblock text \(\d+ of \d+\):\s*(?<sb_text>.*?)\s*ScriptBlock ID:"
| eval CombinedCommand=coalesce(CommandLine, Process_Command_Line, ScriptBlockText, sb_text)
| eval Image=coalesce(Image, New_Process_Name, if(EventCode=4104, "PowerShell ScriptBlock", null()))
| eval ParentImage=coalesce(ParentImage, Creator_Process_Name)
| eval User=coalesce(User, mvindex(Account_Name, -1), UserID)

| eval method=case(
    OriginalFileName="rclone.exe" AND NOT match(Image, "(?i)rclone\.exe$"), "rclone_renamed",
    match(CombinedCommand, "(?i)(api\.telegram\.org|discord(app)?\.com/api/webhooks|mega\.nz|transfer\.sh|gofile\.io|\bfile\.io|0x0\.st|temp\.sh)"), "exfil_service",
    match(CombinedCommand, "(?i)\brclone(\.exe)?\b.*?\b(copy|copyto|sync|move|moveto)\b"), "rclone",
    match(CombinedCommand, "(?i)\bs3\s+(cp|mv|sync)\b|\bs3api\s+put-object\b|\bwrite-s3object\b"), "aws_s3",
    match(CombinedCommand, "(?i)\bgsutil\b.*?\b(cp|mv|rsync)\b|\bgcloud\b.*?\bstorage\s+(cp|mv|rsync)\b"), "gcs",
    match(CombinedCommand, "(?i)\bazcopy(\.exe)?\b.*?\b(copy|cp|sync)\b|\bset-azstorageblobcontent\b"), "azure_blob",
    match(CombinedCommand, "(?i)\bcurl(\.exe)?\b.*?((?-i:\s-[TF])\s|\s--(upload-file|form)\s|(?-i:\s-d)\s+@|\s--data(-binary|-raw)?\s+@|(?-i:\s-X)\s*\W?(post|put)\b)"), "curl",
    match(CombinedCommand, "(?i)\bwget(\.exe)?\b.*?--(post-file|body-file)\b"), "wget",
    match(CombinedCommand, "(?i)\b(invoke-webrequest|iwr|invoke-restmethod|irm|curl|wget)\b.*?\s-(me\w*[\s:]+\W?(post|put)\b|inf\w*\b|form\b)"), "ps_web",
    match(CombinedCommand, "(?i)\.(upload(file|data|string)(async|taskasync)?|postasync|putasync)\s*\("), "dotnet_upload",
    match(CombinedCommand, "(?i)\bbitsadmin\b.*?/upload\b|\bstart-bitstransfer\b.*?-transfertype\s+upload"), "bits_upload",
    match(CombinedCommand, "(?i)\b(p?scp|psftp)(\.exe)?\b.*\s[\w.-]+@[\w.-]+:\S*\s*$"), "scp_upload",
    match(CombinedCommand, "(?i)\brequests\.(post|put)\b|\.upload_file(obj)?\s*\(|\.put_object\s*\("), "python_upload")
| where isnotnull(method)

| rex field=CombinedCommand "(?i)\b(?:s3\s+(?:cp|mv|sync)|gsutil\b.*?\b(?:cp|mv|rsync)|storage\s+(?:cp|mv|rsync)|azcopy(?:\.exe)?\b.*?\b(?:copy|cp|sync)|rclone(?:\.exe)?\b.*?\b(?:copyto|copy|sync|moveto|move))\s+(?:-\S+\s+)*(?<xfer_src>\"[^\"]+\"|\S+)\s+(?<xfer_dst>\"[^\"]+\"|\S+)"
| eval direction=case(isnull(xfer_src), "n/a",
    match(xfer_src, "(?i)^\"?((s3|gs|https?)://|[\w-]{2,}:)") AND match(xfer_dst, "(?i)^\"?([a-z]:\W|[/~]|\W\W|\.{1,2}(\W|$))"), "download",
    true(), "upload/unknown")
| where direction!="download"

`T1567_detection_3_exclusions`

| stats min(_time) as first_seen max(_time) as last_seen count values(EventCode) as EventCodes values(User) as User values(Image) as Image values(ParentImage) as ParentImage values(direction) as direction by host method CombinedCommand
| convert timeformat="%Y-%m-%d %H:%M:%S %Z" ctime(first_seen) ctime(last_seen)
| table first_seen last_seen host User method direction Image ParentImage CombinedCommand EventCodes count
