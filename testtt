          <query><![CDATA[
```Sysmon EID 3 - network connections on the host (selected process first)```
`sysmon_indexes` host=$selected_host|s$
sourcetype="WinEventLog:Microsoft-Windows-Sysmon/Operational"
EventCode=3
earliest=$selected_earliest$
latest=$selected_latest$

| eval process_match = if(ProcessGuid=$selected_process_guid|s$, "selected_process", "same_host_time_window")
| eval match_rank = if(process_match="selected_process", 1, 0)

| sort 0 - match_rank _time
| table _time host process_match User Image SourceIp SourcePort DestinationIp DestinationHostname DestinationPort Protocol ProcessGuid ProcessId
]]></query>
        </search>
        <option name="count">20</option>
        <option name="drilldown">none</option>
        <option name="rowNumbers">true</option>
