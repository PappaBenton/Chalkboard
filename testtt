          <b>Indicators:</b> $selected_indicators$
        </p>
      </html>
    </panel>
  </row>

  <row depends="$selected_host$">
    <panel>
      <title>Raw PowerShell Evidence Around Detection</title>
      <table>
        <search>
          <query><![CDATA[
```Raw PowerShell evidence in the drilldown window (selected block first)```
`WinEvent_indexes` host=$selected_host|s$ earliest=$selected_earliest$ latest=$selected_latest$
sourcetype IN (
    "WinEventLog:Microsoft-Windows-PowerShell/Operational",
    "WinEventLog:PowerShellCore/Operational",
    "powershell:transcription"
)
| rex field=_raw "(?i)(?<sbid_raw>[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\s*(?:path:\s*)?(?<path_raw>[a-z]:[^\r\n]*)?\s*$$"
| eval evidence   = coalesce(ScriptBlockText, Message, _raw)
| eval evidence_l = lower(evidence)
| eval ps_path    = coalesce(Path, ScriptName, path_raw, "")
| eval sbid       = coalesce(ScriptBlockId, ScriptBlock_ID, sbid_raw, "")
| eval user_norm  = coalesce(User, user, UserID, Sid, "unknown_user")
| eval user_norm  = case(
      user_norm="" OR user_norm="NOT_TRANSLATED", "unknown_user",
      user_norm="NT AUTHORITY\\SYSTEM" OR user_norm="S-1-5-18", "SYSTEM",
      true(), user_norm)

| eval has_assembly = if(match(evidence_l, "reflection\.assembly|currentdomain\.load|assembly\.load"), 1, 0)
| eval has_mem_load = if(match(evidence_l, "assembly\]\s*::\s*load\s*\(|currentdomain\.load\s*\(|assembly\.load\s*\("), 1, 0)
| eval has_b64      = if(match(evidence_l, "frombase64string"), 1, 0)
| eval has_byte     = if(match(evidence_l, "byte\[\]|new-object\s+(system\.)?byte"), 1, 0)

```Per-event view of the detection gate; later parts of a split block can show no```
| eval matched_detection_logic = if(has_mem_load=1 AND (has_b64=1 OR has_byte=1), "yes", "no")
| eval selected_block = if(sbid!="" AND sbid=$selected_sbid|s$, "yes", "no")
| eval match_priority = case(selected_block="yes", 2, matched_detection_logic="yes", 1, true(), 0)

| sort 0 - match_priority _time
| table _time host user_norm sourcetype EventCode sbid MessageNumber MessageTotal selected_block ps_path has_assembly has_mem_load has_b64 has_byte matched_detection_logic evidence
]]></query>
        </search>
        <option name="count">20</option>
        <option name="drilldown">none</option>
        <option name="rowNumbers">true</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>

  <row depends="$selected_host$">
    <panel>
      <title>Sysmon Process Creation Around Detection (click a row to pivot)</title>
      <table>
        <search>
          <query><![CDATA[
```Sysmon EID 1 - process creation in the drilldown window```
`sysmon_indexes` host=$selected_host|s$
sourcetype="WinEventLog:Microsoft-Windows-Sysmon/Operational"
EventCode=1
earliest=$selected_earliest$
latest=$selected_latest$

| eval image_l = lower(Image)
| eval is_powershell = if(match(image_l, "\\\\(powershell|pwsh)\\.exe$$"), "yes", "no")

| sort 0 - is_powershell _time
| table _time host User Image CommandLine ParentImage ParentCommandLine CurrentDirectory ProcessGuid ProcessId is_powershell
]]></query>
        </search>
        <option name="count">20</option>
        <option name="drilldown">row</option>
        <option name="rowNumbers">true</option>
        <option name="wrap">true</option>
        <drilldown>
          <set token="selected_process_guid">$row.ProcessGuid$</set>
          <set token="selected_process_image">$row.Image$</set>
          <set token="selected_process_id">$row.ProcessId$</set>
          <set token="selected_process_command">$row.CommandLine$</set>
        </drilldown>
      </table>
    </panel>
  </row>

  <row depends="$selected_process_guid$">
    <panel>
      <html>
        <h2>Selected Process</h2>
        <p>
          <b>ProcessGuid:</b> $selected_process_guid$<br/>
          <b>Image:</b> $selected_process_image$<br/>
          <b>ProcessId:</b> $selected_process_id$<br/>
          <b>CommandLine:</b> $selected_process_command|h$
        </p>
      </html>
    </panel>
  </row>

  <row depends="$selected_process_guid$">
    <panel>
      <title>Sysmon Process Access - Selected Process as Source or Target</title>
      <table>
        <search>
          <query><![CDATA[
```Sysmon EID 10 - process access involving the selected process```
`sysmon_indexes` host=$selected_host|s$
sourcetype="WinEventLog:Microsoft-Windows-Sysmon/Operational"
EventCode=10
earliest=$selected_earliest$
latest=$selected_latest$
(SourceProcessGUID=$selected_process_guid|s$ OR TargetProcessGUID=$selected_process_guid|s$)

| eval process_match = case(
      SourceProcessGUID=$selected_process_guid|s$, "selected_is_source",
      TargetProcessGUID=$selected_process_guid|s$, "selected_is_target",
      true(), "other")

| table _time host process_match SourceUser SourceImage SourceProcessGUID SourceProcessId TargetImage TargetProcessGUID TargetProcessId GrantedAccess CallTrace
| sort 0 _time
]]></query>
        </search>
        <option name="count">20</option>
        <option name="drilldown">none</option>
        <option name="rowNumbers">true</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>

  <row depends="$selected_process_guid$">
    <panel>
      <title>Credential Access Related Process Activity (host-wide)</title>
      <table>
        <search>
          <query><![CDATA[
```Sysmon EID 10 - access to credential-sensitive processes on the host```
`sysmon_indexes` host=$selected_host|s$
sourcetype="WinEventLog:Microsoft-Windows-Sysmon/Operational"
EventCode=10
earliest=$selected_earliest$
latest=$selected_latest$
TargetImage IN ("*\\lsass.exe", "*\\winlogon.exe", "*\\services.exe", "*\\csrss.exe")

| eval target_l = lower(TargetImage)
| eval risk = case(
      match(target_l, "\\\\lsass\\.exe$$"),    "critical",
      match(target_l, "\\\\winlogon\\.exe$$"), "high",
      match(target_l, "\\\\csrss\\.exe$$"),    "high",
      match(target_l, "\\\\services\\.exe$$"), "medium-high",
      true(), "medium")
| eval process_match = if(SourceProcessGUID=$selected_process_guid|s$, "selected_process", "same_host_time_window")

| table _time host risk process_match SourceUser SourceImage SourceProcessGUID SourceProcessId TargetImage TargetProcessId GrantedAccess CallTrace
| sort 0 _time
]]></query>
        </search>
        <option name="count">20</option>
        <option name="drilldown">none</option>
        <option name="rowNumbers">true</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>

  <row depends="$selected_process_guid$">
    <panel>
      <title>Sysmon DLL / Image Loads - Selected Process</title>
      <table>
        <search>
          <query><![CDATA[
```Sysmon EID 7 - image loads by the selected process (in-memory Assembly.Load does not appear here)```
`sysmon_indexes` host=$selected_host|s$
sourcetype="WinEventLog:Microsoft-Windows-Sysmon/Operational"
EventCode=7
earliest=$selected_earliest$
latest=$selected_latest$
ProcessGuid=$selected_process_guid|s$

| eval loaded_l = lower(ImageLoaded)
| eval clr_related = if(
      LIKE(loaded_l, "%\\clr.dll")
      OR LIKE(loaded_l, "%\\clrjit.dll")
      OR LIKE(loaded_l, "%\\mscoree.dll")
      OR LIKE(loaded_l, "%\\mscorlib.dll")
      OR LIKE(loaded_l, "%\\system.private.corelib.dll"),
      "yes", "no")

| table _time host Image ImageLoaded clr_related Signed Signature Hashes ProcessGuid ProcessId
| sort 0 _time
]]></query>
        </search>
        <option name="count">20</option>
        <option name="drilldown">none</option>
        <option name="rowNumbers">true</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>

